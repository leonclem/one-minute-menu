# Production Environment Variables
# Copy this to .env.production for production deployment

# Supabase Configuration (Production)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database Configuration
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# App Configuration
NEXTAUTH_SECRET=your-production-secret-key
NEXTAUTH_URL=https://your-domain.com

# Feature Flags (Production)
NEXT_PUBLIC_ENABLE_OCR=true
NEXT_PUBLIC_ENABLE_AI_PARSING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEVER SET THIS TO TRUE IN PRODUCTION:
NEXT_PUBLIC_ENABLE_DEV_AUTH=false

# Photo Studio pivot (deploy-time; omit or leave as below until ready to switch)
# menu-builder | photo-studio — set photo-studio only when intentionally pivoting FOH
NEXT_PUBLIC_PRODUCT_MODE=menu-builder
# Enable customer /studio route once Chunk 2+ is live
NEXT_PUBLIC_ENABLE_PHOTO_STUDIO=false
# Hide Dashboard/menu-builder primary nav when PRODUCT_MODE=photo-studio
NEXT_PUBLIC_ENABLE_LEGACY_MENUS=true
# Soft daily cap on studio generations per user (pre-credits)
STUDIO_DAILY_GENERATION_LIMIT=25
# Post-gen re-extract + soft quality flag (default on when unset; set false to skip cost)
STUDIO_OUTPUT_VALIDATION_ENABLED=true
# Photo Studio access policy: admin-only | beta | open
# Self-serve launch uses open. The admin Approval Required toggle is then the only customer gate.
NEXT_PUBLIC_STUDIO_ACCESS_MODE=open
# Legacy fallback: restrict FOH /studio to admins (default on); set false to open Studio to customers.
NEXT_PUBLIC_STUDIO_ADMIN_ONLY=true
# Studio export variants: credits are charged only for AI expansion and cut-outs.
# Crop/resize exports and downloads are free by design.
STUDIO_CREDIT_COST_EXPORT_AI=1
STUDIO_CREDIT_COST_EXPORT_CUTOUT=1
# Set true to force every export format to a free crop/resize (no outpainting).
STUDIO_EXPORT_AI_EXPAND_DISABLED=false

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
# NEXT_PUBLIC_POSTHOG_UI_HOST is ONLY required when NEXT_PUBLIC_POSTHOG_HOST points to a
# managed reverse proxy custom domain (e.g. https://edge.gridmenu.ai). When set, it must be
# the PostHog app URL — https://us.posthog.com or https://eu.posthog.com — NOT an ingest host.
# Leave blank when using the default PostHog ingest endpoint directly.
NEXT_PUBLIC_POSTHOG_UI_HOST=

# Performance Configuration
NEXT_PUBLIC_MAX_FILE_SIZE=8388608
NEXT_PUBLIC_PERFORMANCE_BUDGET=133120

# API Keys (Production)
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
OPENAI_API_KEY=your-openai-key

# Google Ads Conversion Tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=your-conversion-label

# Background Removal Provider
BACKGROUND_REMOVAL_PROVIDER=replicate
REPLICATE_API_TOKEN=your-replicate-api-token
# Options: 851-labs (default), codeplugtech
REPLICATE_BACKGROUND_MODEL=851-labs

# Email (Postmark)
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_TRANSACTIONAL_STREAM=outbound
FROM_EMAIL=noreply@gridmenu.ai
FROM_NAME=GridMenu
ADMIN_EMAIL=leon@gridmenu.ai
COMPANY_MAILING_ADDRESS=
# Stripe (core)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Studio credit packs (one-time). Paste Price IDs from Stripe (5 currencies each).
STRIPE_PRICE_ID_STARTER_PACK_SGD=price_...
STRIPE_PRICE_ID_STARTER_PACK_USD=price_...
STRIPE_PRICE_ID_STARTER_PACK_GBP=price_...
STRIPE_PRICE_ID_STARTER_PACK_AUD=price_...
STRIPE_PRICE_ID_STARTER_PACK_EUR=price_...
STRIPE_PRICE_ID_MENU_PACK_SGD=price_...
STRIPE_PRICE_ID_MENU_PACK_USD=price_...
STRIPE_PRICE_ID_MENU_PACK_GBP=price_...
STRIPE_PRICE_ID_MENU_PACK_AUD=price_...
STRIPE_PRICE_ID_MENU_PACK_EUR=price_...
STRIPE_PRICE_ID_STUDIO_PACK_SGD=price_...
STRIPE_PRICE_ID_STUDIO_PACK_USD=price_...
STRIPE_PRICE_ID_STUDIO_PACK_GBP=price_...
STRIPE_PRICE_ID_STUDIO_PACK_AUD=price_...
STRIPE_PRICE_ID_STUDIO_PACK_EUR=price_...